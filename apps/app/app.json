{
  "expo": {
    "name": "Tybacha",
    "slug": "tybacha",
    "scheme": "tybacha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.tybacha.app"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"]
  }
}
